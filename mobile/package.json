{
  "name": "diamond-nine-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:web": "node ../scripts/build-mobile.mjs",
    "sync": "npm run sync:android && npm run sync:ios",
    "sync:android": "node ../scripts/build-mobile.mjs --android && cap sync android",
    "sync:ios": "npm run prepare:web && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@capgo/native-purchases": "8.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
